{
  "$schema": "https://schema.tauri.app/config/1",
  "package": {
    "productName": "kylin-stock",
    "version": "0.1.8"
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "distDir": "../dist"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": {
        "open": true,
        "save": true
      },
      "path": {
        "all": true
      },
      "fs": {
        "writeFile": true
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "物资管理系统",
        "width": 1280,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.devotionn.kylinstock",
      "category": "Business",
      "shortDescription": "物资出入库与库存管理系统",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "deb": {
        "desktopTemplate": "deb.desktop.hbs"
      }
    }
  }
}
